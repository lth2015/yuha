# YUHA configuration.
#
# Copy to .env and fill in. This file contains variable NAMES, descriptions and
# non-sensitive example values only — never a real key (PROJECT_TASK.md §3.2).
#
# The API validates the whole combination at start-up and refuses to boot on an
# illegal one (for example a live Stripe key outside production, or the demo
# music adapter with commercial delivery enabled).

# ─────────────────────────────────────────────── Stripe sandbox (local)
# Placeholders only. Real values live in .env, which is git-ignored.
#
#   1. Dashboard (test mode) -> Developers -> API keys
#        STRIPE_SECRET_KEY=sk_test_...        (server only, never the browser)
#        STRIPE_PUBLISHABLE_KEY=pk_test_...
#   2. Create the catalogue in that same sandbox, amounts read from the
#      database so they cannot drift from what the buyer is shown:
#        pnpm stripe:setup            # dry run
#        pnpm stripe:setup --apply    # creates, prints the price ids
#      Paste the printed ids, then `pnpm seed` copies them into
#      product_catalog.stripe_price_id, which is what checkout reads.
#   3. Forward events to the running API. The CLI uses the same sandbox when
#      given the same secret key, so `stripe login` is not required:
#        stripe listen --api-key "$STRIPE_SECRET_KEY" \
#          --events checkout.session.completed,checkout.session.async_payment_succeeded,\
#checkout.session.async_payment_failed,checkout.session.expired,invoice.paid,\
#invoice.payment_succeeded,invoice.payment_failed,customer.subscription.created,\
#customer.subscription.updated,customer.subscription.deleted,charge.refunded,\
#refund.created,charge.dispute.created \
#          --forward-to localhost:4000/v1/webhooks/stripe
#      It prints whsec_... -> STRIPE_WEBHOOK_SECRET. Restart the API after
#      setting it (`pnpm dev:api`): .env is read at process start.
#      Leave the listener running, or payments succeed at Stripe and no
#      entitlement is ever granted.
#   4. Real Stripe needs PAYMENTS_ADAPTER=stripe; demo mode simulates payments.
#
# No public webhook endpoint and no DNS are needed for local testing.

# For a human acceptance pass:
#
#   cp .env.example .env
#   pnpm bootstrap      # containers, migrations, seed, audio fixtures
#   pnpm preflight      # says exactly what is missing, and the command to fix it
#   pnpm dev
#
# Demo mode needs nothing filled in. Every optional integration below is
# reported as on/off by `pnpm preflight`, so an acceptance pass always knows
# which parts were real. docs/ACCEPTANCE.md is the checklist.

# ─────────────────────────────────────────────────────────── run mode
# demo        | local development: dev login, synthesised audio, simulated payments
# integration | real services wired in as credentials allow; Stripe test mode
# production  | real identity, licensed music service, real payments
RUN_MODE=demo
NODE_ENV=development
PORT=4000
HOST=0.0.0.0
LOG_LEVEL=info
PUBLIC_WEB_URL=http://localhost:5173
PUBLIC_API_URL=http://localhost:4000

# ─────────────────────────────────────────────────────────── database
# MySQL 8.0 / Aurora MySQL 3.x. 8.0 is the floor: SKIP LOCKED, enforced CHECK
# constraints and stored generated columns are load-bearing for the ledger.
DATABASE_URL=mysql://loopscene:loopscene_local_dev@localhost:53306/loopscene_dev
DATABASE_POOL_MAX=10
# Required true in production.
DATABASE_SSL=false

# ─────────────────────────────────────────────────────────── identity
# dev | cognito.  "dev" is rejected in production mode (SEC-03).
AUTH_ADAPTER=dev
# HMAC secret for local dev session tokens. Generate: openssl rand -hex 32
DEV_AUTH_SECRET=replace-with-a-random-32-byte-hex-string
# Who may use the development sign-in (no password). Empty = anyone, the local
# default. "@domain" admits a whole domain, anything else one exact address:
#   DEV_LOGIN_ALLOWLIST=@netstars.co.jp,guest@example.com
DEV_LOGIN_ALLOWLIST=
# Cognito (integration / production). Email OTP runs through Cognito's own
# challenge flow; this API only verifies the resulting id token.
COGNITO_REGION=ap-northeast-1
COGNITO_USER_POOL_ID=
COGNITO_APP_CLIENT_ID=

# ─────────────────────────────────────── text model (via TokenStars, AI-01)
# local | tokenstars.  "local" is a deterministic keyword mapper for demo mode;
# it is not a language model and is recorded as such on every job.
TEXT_ADAPTER=local
# No endpoint path, model id or capability below is guessed — every value must
# come from TokenStars' own documentation. The API refuses to start if the
# tokenstars adapter is selected with any of them missing.
TOKENSTARS_BASE_URL=
TOKENSTARS_API_KEY=
# Exact model id as documented by TokenStars.
TOKENSTARS_MODEL_ID=
# Chat completion path, relative to the base URL, e.g. /v1/chat/completions
TOKENSTARS_CHAT_PATH=
# Response header carrying the upstream request id, if TokenStars exposes one.
TOKENSTARS_REQUEST_ID_HEADER=
# Set true ONLY once pass-through of structured outputs has been verified.
# When false we parse + schema-validate with a single repair attempt.
TOKENSTARS_STRUCTURED_OUTPUTS=false
TOKENSTARS_TIMEOUT_MS=20000
# Budget assumption in JPY minor units, not a confirmed rate.
TOKENSTARS_COST_MINOR_PER_REQUEST=1
# Written lyrics density: about one short line per N seconds (2-10, default 4.5).
LYRIC_SECONDS_PER_LINE=

# ─────────────────────────────────────────────────────── music provider
# demo | http
MUSIC_ADAPTER=demo
DEMO_FIXTURES_DIR=./assets/fixtures/audio
DEMO_LATENCY_MS=1500

# --- http adapter: fill in from the SIGNED provider API documentation --------
MUSIC_PROVIDER_ID=
MUSIC_BASE_URL=
MUSIC_API_KEY=
MUSIC_MODEL=
# Commercial agreement version in force; frozen into every licence record.
MUSIC_CONTRACT_VERSION=
# User-facing licence document version, e.g. jp-launch-2026-09
MUSIC_LICENSE_VERSION=
MUSIC_SUBMIT_PATH=
# Use {id} as the placeholder, e.g. /v1/requests/{id}
MUSIC_POLL_PATH=
MUSIC_CANCEL_PATH=
# Dot-paths into the provider's JSON response.
MUSIC_REQUEST_ID_FIELD=
MUSIC_STATUS_FIELD=
MUSIC_AUDIO_URL_FIELD=
# Provider status strings mapped to our four outcomes.
MUSIC_STATUS_MAP={"pending":[],"completed":[],"failed":[],"rejected":[]}
# Header for an upstream idempotency key, when the provider supports one.
MUSIC_IDEMPOTENCY_HEADER=
# Comma-separated hosts we may fetch audio from (SEC-05). A leading dot matches
# subdomains. Anything else is refused.
MUSIC_ALLOWED_AUDIO_HOSTS=
# A model server we run ourselves on the local network — a GPU box reachable
# only as http://192.168.x.x:8000, which the SSRF guard refuses twice over (not
# https, private address). Lifts exactly those two checks, and only for hosts
# already named above. Development only: loadConfig refuses it in production.
MUSIC_ALLOW_INSECURE_SELF_HOSTED=false
# Only set true where the provider genuinely supports the capability (AI-05).
MUSIC_SUPPORTS_INSTRUMENTAL=false
MUSIC_SUPPORTS_CANCEL=false
MUSIC_SUPPORTS_WEBHOOK=false
MUSIC_SUPPORTS_STATUS_QUERY=true
# Delivering output to end users commercially. Keep false until a signed
# agreement covers it (SEC-09). Cannot be true with the demo adapter.
MUSIC_COMMERCIAL_DELIVERY=false
MUSIC_MAX_CONCURRENCY=4
# Where the provider states it processes data — shown on the privacy page.
MUSIC_DATA_REGION=unconfirmed
# Budget assumption: 45 JPY/request from the unit-economics workbook
# (US$0.3/track at a budget rate of 150 JPY/USD). Not a quote.
MUSIC_COST_MINOR_PER_REQUEST=45
# Conservative default: assume failures are billable until the contract says
# otherwise. Never default this to "failures are free" (AI-06).
MUSIC_BILL_FAILED_REQUESTS=true
MUSIC_COST_IS_ESTIMATE=true
MUSIC_TIMEOUT_MS=60000
MUSIC_MAX_AUDIO_BYTES=26214400

# ─────────────────────────────────────────────────────── lyric alignment
# estimated | http. `estimated` spreads lines across the song by length and
# labels them as such; `http` asks a forced aligner when each line is sung.
# ALIGNMENT_ADAPTER=http
# The self-hosted Spark service aligns with Whisper at POST /v1/align and
# answers lines[].{text,start,end,section,words[].{w,start,end}}:
# ALIGNMENT_PROVIDER_ID=spark-whisper
# ALIGNMENT_BASE_URL=http://10.5.0.7:8583
# ALIGNMENT_API_KEY=            (same key as MUSIC_API_KEY)
# ALIGNMENT_SUBMIT_PATH=/v1/align
# ALIGNMENT_LINES_FIELD=lines
# ALIGNMENT_LINE_TEXT_FIELD=text
# ALIGNMENT_LINE_START_FIELD=start
# ALIGNMENT_LINE_END_FIELD=end
# ALIGNMENT_SECTION_FIELD=section
# ALIGNMENT_WORDS_FIELD=words
# ALIGNMENT_WORD_TEXT_FIELD=w
# ALIGNMENT_WORD_START_FIELD=start
# ALIGNMENT_WORD_END_FIELD=end
# Where the aligner finds the audio; {id} = the music provider's request id.
# ALIGNMENT_AUDIO_URL_TEMPLATE=http://10.5.0.7:8583/v1/audio/{id}.mp3
# ALIGNMENT_TIMEOUT_MS=180000

# ──────────────────────────────────────────────────────────── storage
# local | s3
STORAGE_ADAPTER=local
STORAGE_LOCAL_ROOT=./var/storage
# HMAC secret for local signed download URLs. Generate: openssl rand -hex 32
STORAGE_SIGNING_SECRET=replace-with-a-random-32-byte-hex-string
S3_REGION=ap-northeast-1
# Two separate buckets: raw provider output is never reachable from delivery.
S3_QUARANTINE_BUCKET=
S3_DELIVERY_BUCKET=
S3_KMS_KEY_ID=
# Signed download links are deliberately short-lived (SEC-04).
DOWNLOAD_URL_TTL_SECONDS=300

# ────────────────────────────────────────────────────────────── queue
# local | sqs.  The local adapter is Postgres-backed and reproduces SQS
# Standard semantics (at-least-once, redelivery, DLQ).
QUEUE_ADAPTER=local
QUEUE_NAME=loopscene-generation
SQS_QUEUE_URL=
SQS_REGION=ap-northeast-1

# ─────────────────────────────────────────────────────────── payments
# simulated | stripe.  "simulated" is rejected in production mode.
PAYMENTS_ADAPTER=simulated
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=
# Publishable key only — a secret key must never reach the browser.
STRIPE_PUBLISHABLE_KEY=
# Versioned price ids from the Stripe dashboard.
STRIPE_PRICE_ID_DROP_5=
STRIPE_PRICE_ID_PRO_MONTHLY=
STRIPE_PRICE_ID_PREMIER_MONTHLY=

# ──────────────────────────────────────────── operational switches (§3.2)
# Subscriptions are fully built and tested, but stay closed to the public
# until repeat purchase is demonstrated (§7).
# Declares that this deployment accepts Alipay and WeChat Pay (QR scan).
#
# It does NOT enable them — that is done on the Stripe account, and Stripe's
# automatic payment methods then offer whatever the account supports for the
# session's mode and currency. Both are single-use, so Stripe will not offer
# them on a subscription.
#
# Setting this without enabling them on the account only makes the pricing
# page claim a method the checkout will not show.
STRIPE_WALLETS_ENABLED=false

FEATURE_SUBSCRIPTIONS_ENABLED=false
# Free generations are off by default; at most 2 per account when enabled.
FEATURE_FREE_TRIAL_ENABLED=false
FREE_TRIAL_UNITS=2
# WAV export requires a provider that delivers native lossless audio.
# Transcoding MP3 to WAV is not a quality upgrade and is not offered (UI-07).
FEATURE_WAV_EXPORT_ENABLED=false
MAX_CONCURRENT_JOBS_PER_USER=2
# Daily upstream spend cap in JPY minor units; exceeding it pauses new
# generation while leaving order lookup and existing downloads working.
DAILY_BUDGET_MINOR=50000
GENERATION_RATE_LIMIT_PER_HOUR=30
EXPORT_RATE_LIMIT_PER_HOUR=60

# ─────────────────────────────────────────────────── generation tuning
JOB_LEASE_SECONDS=90
# Past this, the UI says the job is delayed rather than promising a result.
JOB_DELAY_WARNING_SECONDS=180
# Past this, the job is timed out and the credit returned (§12.3).
JOB_VERIFY_DEADLINE_SECONDS=900
# Duration tolerance for the output check (AI-07). MP3 frame padding alone
# accounts for ~40ms on a 30s render.
AUDIO_DURATION_TOLERANCE_MS=750
# How long a song its owner deleted stays recoverable before the audio is
# really removed. A soft delete keeps the file — that is what makes deleting
# the wrong song survivable — and until the retention sweep existed nothing
# ever came back for it. 0 keeps everything for ever.
TRACK_RETENTION_DAYS=90
AUDIO_MIN_MEAN_VOLUME_DB=-45
AUDIO_MIN_BYTES=8000
EXPIRED_BATCH_COMPENSATION_DAYS=30

# ──────────────────────────────────────── legal disclosure (SEC-13, 特商法)
# Production refuses to start without the first three. Placeholders are
# acceptable for a demo and are labelled as placeholders in the UI.
# Left blank on purpose. These five are published verbatim as the 販売業者
# block on /legal/tokushoho and as the data controller on /legal/privacy, so
# an example file must not carry a real party's details — it did, and every
# demo named a company that does not operate this service.
#
# The live values are in `deploy/envs/production.yaml` (and your own .env for
# a local run). The operator is <redacted: operator name>, a sole proprietor (個人事業主), and all
# five fields are set there as of 2026-10-02.
LEGAL_ENTITY_NAME=
LEGAL_ENTITY_REPRESENTATIVE=
LEGAL_ENTITY_ADDRESS=
LEGAL_ENTITY_CONTACT=
LEGAL_ENTITY_PHONE=
