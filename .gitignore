node_modules/
dist/
build/
coverage/
*.tsbuildinfo

# real secrets never belong in the repo — only .env.example is tracked
.env
.env.*
!.env.example

# local object storage + generated audio fixtures
# (the fixtures are synthesised from scripts/make-audio-fixtures.mjs — the script is
#  the tracked source of truth, the rendered audio is a build artefact)
# Anchored so the pattern cannot swallow source dirs like packages/*/src/storage/.
/var/
/storage/
assets/fixtures/audio/
apps/web/dist/
.vite/
.DS_Store
*.log

# Terraform local state and provider plugins (the lock file IS tracked)
infra/terraform/.terraform/
infra/terraform/*.tfstate
infra/terraform/*.tfstate.*
infra/terraform/*.tfvars
!infra/terraform/*.tfvars.example

# Local tool state, never shared: per-machine editor/agent settings, browser
# automation scratch, and the folder Claude writes deliverables into. Each of
# these is specific to one person's machine, so tracking them would hand the
# next checkout somebody else's configuration.
.claude/settings.local.json
.playwright-mcp/
Claude outputs/

# DGX deploy scratch (deploy/dgx): bench recordings, build logs, local data
deploy/dgx/music/bench_out/
deploy/dgx/music/build.log
deploy/dgx/music/data/

# Python bytecode from the DGX service scripts
__pycache__/
*.pyc

# Agent session transfer artifacts (CLAUDE.md, "Running the suite from outside
# this machine"). They have to sit inside this folder, because that is the only
# place a cloud session can copy files out of — so they are ignored here rather
# than kept elsewhere. Untracked, they would otherwise be swept into the very
# patch being built: work.patch would carry the whole 8MB bundle inside itself.
# Any bundle, not just the one name: a bundle carrying the pre-redaction
# history is exactly the file that must never be committed, and it arrives
# under whatever name the session gave it (`yuha-redacted.bundle` did).
*.bundle
/work.patch
