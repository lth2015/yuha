{
  "name": "@loopscene/db",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    }
  },
  "scripts": {
    "build": "tsc -p tsconfig.json && node ../../scripts/copy-migrations.mjs",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "migrate": "tsx --env-file-if-exists=../../.env src/cli.ts migrate",
    "reset": "tsx --env-file-if-exists=../../.env src/cli.ts reset"
  },
  "dependencies": {
    "@loopscene/contracts": "workspace:*",
    "mysql2": "^3.11.5"
  },
  "devDependencies": {
    "tsx": "^4.19.2",
    "typescript": "^5.7.2"
  }
}