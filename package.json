{
  "name": "yuha",
  "version": "0.1.0",
  "private": true,
  "description": "YUHA \u2014 an AI song studio: describe a feeling, get a finished song",
  "packageManager": "pnpm@11.1.2",
  "engines": {
    "node": ">=22.0.0"
  },
  "type": "module",
  "scripts": {
    "build": "pnpm -r --filter \"./packages/**\" build && pnpm -r --filter \"./apps/**\" build",
    "typecheck": "pnpm -r typecheck",
    "preflight": "node scripts/preflight.mjs",
    "stripe:setup": "node scripts/stripe-sandbox-setup.mjs",
    "acceptance": "node scripts/preflight.mjs --verbose && pnpm dev",
    "check:orphans": "node scripts/find-orphan-exports.mjs",
    "check:i18n": "node scripts/check-i18n.mjs",
    "check:contrast": "node scripts/check-contrast.mjs",
    "check:limits": "node scripts/check-codepoint-limits.mjs",
    "check:type": "node scripts/check-type-scale.mjs",
    "pretest": "node scripts/check-build-fresh.mjs",
    "test": "vitest run",
    "test:watch": "vitest",
    "dev": "concurrently -n api,worker,web -c green,magenta,cyan \"pnpm dev:api\" \"pnpm dev:worker\" \"pnpm dev:web\"",
    "dev:api": "pnpm --filter @yuha/api dev",
    "dev:worker": "pnpm --filter @yuha/worker dev",
    "dev:web": "pnpm --filter @yuha/web dev",
    "db:up": "docker compose up -d mysql mysql-test",
    "db:down": "docker compose down",
    "db:migrate": "pnpm --filter @yuha/db migrate",
    "db:reset": "pnpm --filter @yuha/db reset",
    "seed": "pnpm --filter @yuha/api seed",
    "fixtures:audio": "node scripts/make-audio-fixtures.mjs",
    "bootstrap": "pnpm install && pnpm fixtures:audio && pnpm db:up && node --env-file-if-exists=.env scripts/wait-for-db.mjs && node scripts/wait-for-db.mjs mysql://localhost:53307 && pnpm db:migrate && pnpm seed"
  },
  "devDependencies": {
    "@types/node": "^22.10.2",
    "@yuha/api": "workspace:*",
    "@yuha/contracts": "workspace:*",
    "@yuha/db": "workspace:*",
    "@yuha/providers": "workspace:*",
    "@yuha/worker": "workspace:*",
    "concurrently": "^9.1.0",
    "ganache": "7.9.2",
    "solc": "0.8.37",
    "typescript": "^5.7.2",
    "viem": "2.57.3",
    "vitest": "^2.1.8"
  }
}
