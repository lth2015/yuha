  "motion": {
    "waitCycleMs": 2400,
    "waitMaxCycles": 2,
    "heroPetalMs": 720,
    "resultMs": 520,
    "hoverLiftPx": 3,
    "reduceMotion": "disable decorative transform/opacity animation; retain functional audio progress"
  },
  "breakpoints": {
    "mobileMaxPx": 767,
    "tabletMaxPx": 1023,
    "contentMaxPx": 1200
  }
