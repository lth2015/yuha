{
  "brand": "YUHA",
  "version": "1.0",
  "slogan": "让心动，有回声。",
  "cssCustomProperties": {
    "--yuha-bg": "#F6F5F0",
    "--yuha-surface": "#FFFFFF",
    "--yuha-surface-soft": "#ECEEE7",
    "--yuha-ink": "#20221F",
    "--yuha-muted": "#61665D",
    "--yuha-line": "#D8DAD3",
    "--yuha-control-line": "#7B8177",
    "--yuha-petal": "#F46B45",
    "--yuha-petal-soft": "#FFE4D8",
    "--yuha-link": "#A33F22",
    "--yuha-focus": "#5748B9",
    "--yuha-success": "#28704B",
    "--yuha-warning": "#855619",
    "--yuha-danger": "#B33131",
    "--yuha-font": "-apple-system, BlinkMacSystemFont, \"Segoe UI\", \"Hiragino Kaku Gothic ProN\", \"Yu Gothic\", \"PingFang SC\", \"Microsoft YaHei\", \"Noto Sans CJK SC\", sans-serif",
    "--yuha-space-1": "4px",
    "--yuha-space-2": "8px",
    "--yuha-space-3": "12px",
    "--yuha-space-4": "16px",
    "--yuha-space-6": "24px",
    "--yuha-space-8": "32px",
    "--yuha-space-12": "48px",
    "--yuha-space-16": "64px",
    "--yuha-radius-control": "14px",
    "--yuha-radius-card": "24px",
    "--yuha-radius-sheet": "28px",
    "--yuha-shadow-raised": "0 8px 32px rgb(32 34 31 / 6%)",
    "--yuha-duration-press": "100ms",
    "--yuha-duration-ui": "160ms",
    "--yuha-duration-panel": "240ms",
    "--yuha-duration-enter": "480ms",
    "--yuha-ease-out": "cubic-bezier(.22,1,.36,1)",
    "--yuha-ease-ui": "cubic-bezier(.2,.8,.2,1)"
